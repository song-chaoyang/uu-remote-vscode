      },
      {
        "command": "uu.downloadUuRemote",
        "title": "UU远程: 下载安装 UU远程(官网)",
        "category": "UU远程"
      },
      {
        "command": "uu.cliMissingGuide",
        "title": "UU远程: 安装引导(未找到 CLI 时)",
