        "category": "UU远程"
      },
      {
        "command": "uu.term.open",
        "title": "UU远程: 打开远程终端",
        "icon": "$(terminal)",
        "category": "UU远程"
      },
      {
        "command": "uu.term.newSession",
        "title": "UU远程: 新建远程终端会话",
        "category": "UU远程"
      },
      {
        "command": "uu.term.listSessions",
