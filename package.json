    "configuration": {
      "title": "UU远程助手",
      "properties": {
        "uu.cliPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "uuyc-cli 可执行文件的完整路径。留空时自动探测(常见安装目录 + `where uuyc-cli`)。\n\nUU远程安装后 CLI 通常位于 `C:\\Program Files\\Netease\\GameViewer\\bin\\uuyc-cli.exe`。"
        },
        "uu.autoRefreshSeconds": {
          "type": "number",
          "default": 10,
          "minimum": 0,
          "description": "设备 / 云电脑列表与连接状态的自动刷新间隔(秒)。设为 0 禁用自动刷新。"
        },
        "uu.term.defaultShell": {
          "type": "string",
          "enum": [
            "powershell",
            "cmd",
            "zsh",
            "bash"
          ],
          "default": "powershell",
          "enumDescriptions": [
            "PowerShell(Windows 远程设备默认)",
            "CMD(Windows 远程设备)",
            "Zsh(macOS/Linux 远程设备)",
            "Bash(Linux 远程设备)"
          ],
          "description": "远程终端默认 Shell。"
        }
      }
    }
