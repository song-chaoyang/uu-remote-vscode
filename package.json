      },
      {
        "command": "uu.wirelessScreen.open",
        "title": "UU远程: 打开无线副屏",
        "icon": "$(device-mobile)",
        "category": "UU远程"
      },
      {
        "command": "uu.wirelessScreen.launch",
        "title": "UU远程: 启动无线副屏(主程序)",
        "icon": "$(play)",
        "category": "UU远程"
      },
      {
        "command": "uu.wirelessScreen.website",
        "title": "UU远程: 无线副屏官方介绍",
        "category": "UU远程"
      },
      {
        "command": "uu.wirelessScreen.forDevice",
        "title": "UU远程: 无线副屏(该设备/引导)",
        "category": "UU远程"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "uu.refreshDevices",
          "when": "view == uuDevices",
          "group": "navigation@1"
        },
