        "category": "UU远程"
      },
      {
        "command": "uu.showOutput",
        "title": "UU远程: 打开输出日志",
        "category": "UU远程"
      },
      {
        "command": "uu.uploadToRemote",
        "title": "UU远程: 上传文件到设备",
