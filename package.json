{
  "name": "uuyc-cli",
  "displayName": "UU远程助手 (UU Remote)",
  "description": "网易 UU远程 (GameViewer) 的 VSCode 集成:设备连接、云电脑管理、远程终端、附加到编辑器、AI 工具(MCP)、码率/模式设置与输入诊断。基于官方 uuyc-cli 封装。",
  "version": "0.8.3",
  "publisher": "song-chaoyang",
  "license": "MIT",
  "engines": {
    "vscode": "^1.136.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "uu",
    "uuyc",
    "remote",
    "gameviewer",
    "netease",
    "cloud pc",
    "remote control"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onFileSystem:uu-remote"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "uu-remote.mcpServer",
        "label": "UU远程助手 MCP"
      }
    ],
    "languageModelTools": [
      {
        "name": "uu_list_devices",
        "displayName": "列出 UU远程设备",
        "modelDescription": "列出 UU远程账号下所有可连接的远程设备,含名称、设备 ID、在线状态与当前串流连接状态。",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "uuDevices",
        "inputSchema": {
          "type": "object",
          "properties": {}
        }
      },
      {
        "name": "uu_remote_exec",
        "displayName": "远程执行 PowerShell",
        "modelDescription": "在指定的 UU远程设备上执行一条 shell 命令并返回输出。Windows 被控端用 PowerShell 语法;macOS/Linux 用 zsh/bash 语法。",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "uuExec",
        "inputSchema": {
          "type": "object",
          "properties": {
            "device_id": {
              "type": "string",
              "description": "目标设备 ID"
            },
            "command": {
              "type": "string",
              "description": "要执行的 PowerShell 命令"
            },
            "shell": {
              "type": "string",
              "enum": [
                "powershell",
                "zsh",
                "bash"
              ],
              "description": "被控端 Shell;Windows 默认 powershell,macOS/Linux 选 zsh 或 bash"
            }
          },
          "required": [
            "device_id",
            "command"
          ]
        }
      },
      {
        "name": "uu_remote_list_dir",
        "displayName": "列出远程目录",
        "modelDescription": "列出远程设备上指定目录的文件与子目录(含大小)。",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "uuDir",
        "inputSchema": {
          "type": "object",
          "properties": {
            "device_id": {
              "type": "string",
              "description": "目标设备 ID"
            },
            "path": {
              "type": "string",
              "description": "远程 Windows 目录绝对路径"
            },
            "shell": {
              "type": "string",
              "enum": [
                "powershell",
                "zsh",
                "bash"
              ],
              "description": "被控端 Shell;Windows 默认 powershell,macOS/Linux 选 zsh 或 bash"
            }
          },
          "required": [
            "device_id",
            "path"
          ]
        }
      },
      {
        "name": "uu_remote_read_file",
        "displayName": "读取远程文件",
        "modelDescription": "读取远程设备上的文本文件内容(UTF-8,≤256KB)。",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "uuRead",
        "inputSchema": {
          "type": "object",
          "properties": {
            "device_id": {
              "type": "string",
              "description": "目标设备 ID"
            },
            "path": {
              "type": "string",
              "description": "远程 Windows 文件绝对路径"
            },
            "shell": {
              "type": "string",
              "enum": [
                "powershell",
                "zsh",
                "bash"
              ],
              "description": "被控端 Shell;Windows 默认 powershell,macOS/Linux 选 zsh 或 bash"
            }
          },
          "required": [
            "device_id",
            "path"
          ]
        }
      },
      {
        "name": "uu_remote_write_file",
        "displayName": "写入远程文件",
        "modelDescription": "将文本内容写入远程设备的指定文件(UTF-8,≤512KB,自动创建,覆盖已存在文件)。破坏性操作。",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "uuWrite",
        "inputSchema": {
          "type": "object",
          "properties": {
            "device_id": {
              "type": "string",
              "description": "目标设备 ID"
            },
            "path": {
              "type": "string",
              "description": "远程 Windows 文件绝对路径"
            },
            "content": {
              "type": "string",
              "description": "要写入的文本内容"
            },
            "shell": {
              "type": "string",
              "enum": [
                "powershell",
                "zsh",
                "bash"
              ],
              "description": "被控端 Shell;Windows 默认 powershell,macOS/Linux 选 zsh 或 bash"
            }
          },
          "required": [
            "device_id",
            "path",
            "content"
          ]
        }
      },
      {
        "name": "uu_connect_device",
        "displayName": "串流连接设备",
        "modelDescription": "发起对远程设备的串流连接(远程控制),窗口由 UU远程主应用打开。",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "uuConnect",
        "inputSchema": {
          "type": "object",
          "properties": {
            "device_id": {
              "type": "string",
              "description": "目标设备 ID"
            }
          },
          "required": [
            "device_id"
          ]
        }
      },
      {
        "name": "uu_disconnect_device",
        "displayName": "断开设备连接",
        "modelDescription": "断开远程设备的串流连接;不传 device_id 则断开全部。",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "uuDisconnect",
        "inputSchema": {
          "type": "object",
          "properties": {
            "device_id": {
              "type": "string",
              "description": "目标设备 ID;省略则断开全部"
            }
          }
        }
      },
      {
        "name": "uu_cloudpc_list",
        "displayName": "列出云电脑",
        "modelDescription": "列出 UU远程账号下的云电脑,含 ID、名称、运行状态。",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "uuCloudPcs",
        "inputSchema": {
          "type": "object",
          "properties": {}
        }
      },
      {
        "name": "uu_cloudpc_power",
        "displayName": "云电脑开机/关机",
        "modelDescription": "对指定云电脑执行开机(on)或关机(off)。关机为破坏性操作。",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "uuCloudPcPower",
        "inputSchema": {
          "type": "object",
          "properties": {
            "cloudpc_id": {
              "type": "string",
              "description": "云电脑 ID(来自 uu_cloudpc_list)"
            },
            "action": {
              "type": "string",
              "enum": [
                "on",
                "off"
              ],
              "description": "on=开机,off=关机"
            }
          },
          "required": [
            "cloudpc_id",
            "action"
          ]
        }
      },
      {
        "name": "uu_echo_test",
        "displayName": "测试主应用通信",
        "modelDescription": "向 UU远程主应用发送回显消息,验证 CLI 与主应用通信是否正常。",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "uuEcho",
        "inputSchema": {
          "type": "object",
          "properties": {
            "message": {
              "type": "string",
              "description": "要回显的消息(默认 hello)"
            }
          }
        }
      },
      {
        "name": "uu_local_device_id",
        "displayName": "获取本机设备 ID",
        "modelDescription": "获取当前这台电脑在 UU远程中的设备 ID。",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "uuMyId",
        "inputSchema": {
          "type": "object",
          "properties": {}
        }
      },
      {
        "name": "uu_pty_open",
        "displayName": "打开交互式远程终端",
        "modelDescription": "在目标设备上打开持久交互式远程终端,返回 handle 与屏幕快照。处理 ssh 密码、y/n 确认等交互场景;普通单次命令优先用 uu_remote_exec。",
        "toolReferenceName": "uuPtyOpen",
        "inputSchema": {
          "type": "object",
          "properties": {
            "device_id": {
              "type": "string",
              "description": "目标设备 ID"
            },
            "shell": {
              "type": "string",
              "enum": [
                "powershell",
                "cmd",
                "zsh",
                "bash"
              ],
              "description": "远程 Shell;Windows 默认 powershell"
            }
          },
          "required": [
            "device_id"
          ]
        },
        "canBeReferencedInPrompt": true
      },
      {
        "name": "uu_pty_send",
        "displayName": "向交互终端发送输入",
        "modelDescription": "向 uu_pty_open 打开的交互式终端发送输入(\\r 表示回车),等待 wait_ms 后返回屏幕快照。",
        "toolReferenceName": "uuPtySend",
        "inputSchema": {
          "type": "object",
          "properties": {
            "handle": {
              "type": "string",
              "description": "会话 handle"
            },
            "keys": {
              "type": "string",
              "description": "要发送的输入;\\r 表示回车"
            },
            "wait_ms": {
              "type": "number",
              "description": "发送后等待毫秒数(默认 500)"
            }
          },
          "required": [
            "handle",
            "keys"
          ]
        },
        "canBeReferencedInPrompt": true
      },
      {
        "name": "uu_pty_read",
        "displayName": "读取交互终端屏幕",
        "modelDescription": "读取交互式终端当前屏幕快照。",
        "toolReferenceName": "uuPtyRead",
        "inputSchema": {
          "type": "object",
          "properties": {
            "handle": {
              "type": "string",
              "description": "会话 handle"
            }
          },
          "required": [
            "handle"
          ]
        },
        "canBeReferencedInPrompt": true
      },
      {
        "name": "uu_pty_close",
        "displayName": "关闭交互终端",
        "modelDescription": "关闭交互式终端会话(远程正常 exit,不残留)。",
        "toolReferenceName": "uuPtyClose",
        "inputSchema": {
          "type": "object",
          "properties": {
            "handle": {
              "type": "string",
              "description": "会话 handle"
            }
          },
          "required": [
            "handle"
          ]
        },
        "canBeReferencedInPrompt": true
      },
      {
        "name": "uu_remote_launch",
        "displayName": "远程启动程序",
        "modelDescription": "在远程设备上启动一个程序(Start-Process),如记事本、任务管理器、任意应用。仅 Windows 被控端。",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "uuLaunch",
        "inputSchema": {
          "type": "object",
          "properties": {
            "device_id": {
              "type": "string",
              "description": "目标设备 ID"
            },
            "program": {
              "type": "string",
              "description": "程序路径或名称,如 notepad.exe"
            }
          },
          "required": [
            "device_id",
            "program"
          ]
        }
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "uu-remote",
          "title": "UU远程",
          "icon": "media/uu.svg"
        }
      ]
    },
    "views": {
      "uu-remote": [
        {
          "id": "uuDevices",
          "name": "设备"
        },
        {
          "id": "uuCloudPcs",
          "name": "云电脑"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "uuDevices",
        "contents": "正在连接 UU远程主应用…\n若长时间无响应,请确认主应用已运行并登录、本机已安装 uuyc-cli。\n[刷新设备列表](command:uu.refreshDevices)\n[打开输出日志](command:uu.showOutput)\n[设置 CLI 路径](command:uu.openCliSettings)"
      },
      {
        "view": "uuCloudPcs",
        "contents": "正在获取云电脑列表…\n请确认 UU远程主应用已运行并登录。\n[刷新云电脑列表](command:uu.cloudpc.refresh)\n[打开输出日志](command:uu.showOutput)"
      }
    ],
    "commands": [
      {
        "command": "uu.refreshDevices",
        "title": "UU远程: 刷新设备列表",
        "icon": "$(refresh)",
        "category": "UU远程"
      },
      {
        "command": "uu.connectDevice",
        "title": "UU远程: 连接设备(串流)",
        "icon": "$(play)",
        "category": "UU远程"
      },
      {
        "command": "uu.disconnectDevice",
        "title": "UU远程: 断开设备",
        "category": "UU远程"
      },
      {
        "command": "uu.disconnectAllDevices",
        "title": "UU远程: 断开所有设备",
        "category": "UU远程"
      },
      {
        "command": "uu.showDeviceStatus",
        "title": "UU远程: 查看连接状态",
        "category": "UU远程"
      },
      {
        "command": "uu.getLocalDeviceId",
        "title": "UU远程: 获取本机设备 ID",
        "category": "UU远程"
      },
      {
        "command": "uu.resetCustomCode",
        "title": "UU远程: 重置自定义验证码",
        "category": "UU远程"
      },
      {
        "command": "uu.openCliSettings",
        "title": "UU远程: 打开 CLI 路径设置",
        "category": "UU远程"
      },
      {
        "command": "uu.showDeviceDetails",
        "title": "UU远程: 设备详情",
        "icon": "$(info)",
        "category": "UU远程"
      },
      {
        "command": "uu.copyDeviceId",
        "title": "UU远程: 复制设备 ID",
        "category": "UU远程"
      },
      {
        "command": "uu.attachToEditor",
        "title": "UU远程: 附加到编辑器 (Attach to Editor)",
        "icon": "$(remote-explorer)",
        "category": "UU远程"
      },
      {
        "command": "uu.cloudpc.refresh",
        "title": "UU远程: 刷新云电脑列表",
        "icon": "$(refresh)",
        "category": "UU远程"
      },
      {
        "command": "uu.cloudpc.launch",
        "title": "UU远程: 云电脑开机",
        "icon": "$(play)",
        "category": "UU远程"
      },
      {
        "command": "uu.cloudpc.shutdown",
