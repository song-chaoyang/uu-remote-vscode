      {
        "command": "uu.showCloudPcDetails",
        "title": "UU远程: 云电脑详情",
        "icon": "$(info)",
        "category": "UU远程"
      },
      {
        "command": "uu.copyCloudPcId",
        "title": "UU远程: 复制云电脑 ID",
        "category": "UU远程"
      },
      {
        "command": "uu.showUserInfo",
